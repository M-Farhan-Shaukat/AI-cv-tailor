APP_NAME="AI Resume Tailor & ATS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=resume_tailor_ats
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

SESSION_DRIVER=database
SESSION_LIFETIME=120

CACHE_STORE=database

# Configure these in the admin panel instead of here (log in as a super admin):
#   Admin → AI keys        Groq API keys
#   Admin → Settings       Billing & plans, Stripe, Email (SMTP), Job provider keys
#   Admin → Job feeds      Search terms and auto-sync
#   Admin → AdSense        Publisher ID and ad units
# Create the first super admin with: php artisan db:seed --class=AdminUserSeeder

# Optional tuning (sensible defaults are built in)
JOB_PER_PAGE=50
JOB_STALE_AFTER_DAYS=14
JOB_MATCH_LIMIT=25
JOB_RESULTS_PER_PAGE=20
JOB_MAX_CV_CHARACTERS=8000
JOB_SCAN_STATUS_TTL=3600
JOB_SAVED_SEARCH_INTERVAL_MINUTES=60
JOB_SAVED_SEARCH_LIMIT=100
JOB_SAVED_SEARCH_MIN_SCORE=60
JOB_CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
JOB_CIRCUIT_BREAKER_COOLDOWN_MINUTES=15

# AI budgets (0 disables a limit)
LLM_DAILY_TOKEN_LIMIT=2000000
LLM_DAILY_USER_TOKEN_LIMIT=200000
LLM_DAILY_REQUEST_LIMIT=1000
LLM_DAILY_USER_REQUEST_LIMIT=200
LLM_INPUT_COST_PER_MILLION=0
LLM_OUTPUT_COST_PER_MILLION=0

# Security headers
SECURITY_CSP_ENABLED=true

# Matching runs as a long queued job; keep retry_after above the job timeout.
DB_QUEUE_RETRY_AFTER=900

VITE_APP_NAME="${APP_NAME}"
